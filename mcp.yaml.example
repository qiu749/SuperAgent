# WeAgent MCP 服务配置示例（复制为 mcp.yaml 启用）
# - readOnlyHint 工具或 direct 列表中的工具直接执行（图片输出直传多模态模型）；
# - desktopMutex: true 启用全局桌面互斥锁并替代内置 legacy computer_action；
# - 其余不可逆工具（或 requireApproval 列表工具）调用时自动生成审批草稿，批准后由宿主机执行。
servers:
  # 1. 原生开源桌面控制 MCP（open-computer-use，兼容 Kimi/Codex Computer Use 11 项工具接口）
  # 注意：macOS 需在「系统设置 -> 隐私与安全性 -> 辅助功能 / 屏幕录制」中勾选宿主终端
  - name: computer_use
    command: ./node_modules/.bin/open-computer-use
    args: ["mcp"]
    desktopMutex: true
    direct:
      - list_apps
      - query
      - get_app_state
      - click
      - drag
      - scroll
      - type_text
      - set_value
      - select_text
      - press_key
      - perform_secondary_action

  # 2. 本地文件系统 MCP（可选）
  # - name: filesystem
  #   command: npx
  #   args: ["-y", "@modelcontextprotocol/server-filesystem", "/tmp/weagent-workspace"]
  #   allow: ["read_file", "list_directory"]

  # 3. HTTP 方式示例（可选）
  # - name: search
  #   url: https://mcp.example.com/mcp
  #   headers:
  #     Authorization: Bearer xxx
