# 企业微信自建应用配置
WECOM_CORP_ID=wwxxxxxxxxxxxxxxxx
WECOM_AGENT_ID=1000002
WECOM_SECRET=your_app_secret
WECOM_TOKEN=your_callback_token
WECOM_AES_KEY=your_43_char_encoding_aes_key

# 白名单用户（企微=UserID；飞书=open_id；逗号分隔）
ALLOWED_USERS=qiu

# 飞书接入（可选；长连接模式，免公网。配置 App ID/Secret 即启用并优先于企微出站）
FEISHU_APP_ID=
FEISHU_APP_SECRET=

# 主动触发模式: off | observe (默认观察模式) | auto
ACCEPT_MODE=observe

# 大模型配置 (DeepSeek 官方或兼容中转站)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# 中转站 API 地址（官方留空；中转站填其文档地址，如 https://api.xxx.com/v1）
DEEPSEEK_BASE_URL=
ROUTER_MODEL=deepseek-flash
WORKER_MODEL=deepseek-v4-pro

# 并发控制 (常规 Worker 槽位 + 额外 1 个人类优先紧急槽位)
MAX_WORKERS=3

# 长期记忆 (Mem0: oss 本地模式 或 cloud 模式)
MEM0_MODE=oss
MEM0_API_KEY=
EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=BAAI/bge-m3

# 搜索与沙箱
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
DATA_DIR=./data
SANDBOX_IMAGE=weagent-sandbox:latest
MCP_CONFIG=./mcp.yaml
PORT=8000

# ===== v1.0 (M6-M10) =====
# 语音转写 ASR（OpenAI 兼容 /v1/audio/transcriptions，如硅基流动 SenseVoiceSmall；不配则语音消息回复未配置提示）
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_API_KEY=
ASR_MODEL=FunAudioLLM/SenseVoiceSmall
FFMPEG_PATH=ffmpeg

# 批量摘要卡时点（工作日，逗号分隔 HH:MM）与信任放权阈值（连续无修改批准 N 次后询问升级）
DIGEST_TIMES=10:00,17:00
TRUST_AUTO_THRESHOLD=10

# 持久化浏览器与编码子 Agent
PLAYWRIGHT_EXECUTABLE_PATH=
REPOS={"repo-key": {"path": "/abs/path/to/repo"}}

# H5 面板会话签名密钥（生产必改）
PANEL_SECRET=weagent-panel-dev-secret
# H5 面板对外基址（digest 卡与远程协助链接会用它拼 URL）
PANEL_BASE_URL=
